<?xml version="1.0" encoding="UTF-8"?>
<!-- Site-wide values: your name, contact details, navigation, SEO defaults and shared button copy.
     Riley Carter is a fictional sample persona. Replace every value with your own. -->
<global-elements>

  <!-- Global Elements -->
  <global>
    <site-title>Riley Carter | Product Leadership</site-title>
    <tagline>Engineer by training. Product leader by choice.</tagline>
    <owner-name>Riley Carter</owner-name>
    <!-- Your live URL, no trailing slash. The SITE_URL env var overrides it. -->
    <site-url>https://example.com</site-url>
    <contact-email>riley@example.com</contact-email>
    <!-- Optional. Remove this line to hide the "grab time on my calendar" button. -->
    <scheduling-url>https://cal.example.com/riley-carter/30min</scheduling-url>
    <!-- Optional footer link back to the template. Keep it if you'd like to say thanks; remove it to hide. -->
    <credit href="https://github.com/m0r0ccomole/productPortfolio">Built with productPortfolio</credit>

    <navigation>
      <item href="/">Home</item>
      <item href="/deep-dives">Work &amp; Impact</item>
      <item href="/about">About</item>
      <item href="/projects">Projects</item>
      <item href="/blog">Blog</item>
    </navigation>

    <!-- Small UI labels shared across pages. Optional: any key you leave out
         uses the text from sample/content/global-elements.xml. An empty label
         hides that text. Words in {braces} are filled in by the site; keep them. -->
    <ui-labels>
      <!-- Layout, navigation, images -->
      <label key="skip-link">Skip to main content</label>
      <label key="footer-privacy">Privacy Policy</label>
      <label key="footer-contact">Contact</label>
      <label key="footer-rights">All rights reserved.</label>
      <label key="last-updated">Last updated:</label>
      <label key="nav-toggle-menu">Toggle menu</label>
      <label key="headshot-alt">Profile photo</label>
      <label key="headshot-placeholder">Profile photo placeholder</label>
      <label key="hero-image-alt">Hero image</label>
      <label key="image-close">Close modal</label>

      <!-- Blog -->
      <label key="read-more">Read more →</label>
      <label key="min-read">{minutes} min read</label>
      <label key="blog-back">← Back to Blog</label>
      <label key="prompt-copy">Copy to clipboard</label>
      <label key="prompt-show-comment">Show comment</label>
      <label key="prompt-hide-comment">Hide comment</label>

      <!-- Testimonials -->
      <label key="testimonials-heading">What Others Say</label>
      <label key="testimonials-previous">Previous testimonials</label>
      <label key="testimonials-next">Next testimonials</label>
      <label key="testimonials-page">Go to testimonials page {page}</label>
      <label key="testimonial-image-alt">{name} headshot</label>
      <label key="testimonial-placeholder">{name} profile photo placeholder</label>

      <!-- Case studies and product briefs -->
      <label key="deep-dive-brief-badge">Product Brief</label>
      <label key="deep-dive-role">Role</label>
      <label key="deep-dive-company">Company</label>
      <label key="deep-dive-timeframe">Timeframe</label>
      <label key="deep-dive-stakes">Stakes</label>
      <label key="deep-dive-challenge">Challenge</label>
      <label key="deep-dive-problem">The Problem</label>
      <label key="deep-dive-opportunity">The Opportunity</label>
      <label key="deep-dive-approach">My Approach</label>
      <label key="deep-dive-build">How We Built It</label>
      <label key="deep-dive-results">Results</label>
      <label key="deep-dive-achieved">What We Achieved</label>
      <label key="deep-dive-evidence">Evidence you can see in action</label>
      <label key="deep-dive-email-subject">Discussion: {title}</label>
      <label key="deep-dive-meta-description">Case study: {summary}</label>
      <label key="deep-dive-meta-keywords">case study, product management, {company}, {id}</label>

      <!-- Industry pages -->
      <label key="industry-relevance">Here's What I Bring</label>
      <label key="industry-achievements">Key Achievements</label>
      <label key="industry-more-work">View more of my work →</label>
      <label key="industry-skills">Relevant Skills</label>
      <label key="industry-meta-title">{industry} Experience | {owner}</label>
      <label key="industry-meta-description">{industry} product leadership experience and achievements by {owner}</label>
      <label key="industry-meta-keywords">{industry}, product management, {id}, experience</label>

      <!-- Shown on /hello when the hello page or its generic greeting is missing -->
      <label key="hello-fallback-heading">Hello there!</label>
      <label key="hello-fallback-message">Thanks for visiting.</label>
    </ui-labels>

    <buttons>
      <cta-primary>View My Work</cta-primary>
      <cta-secondary>Let's Connect</cta-secondary>
      <cta-email>Get in Touch</cta-email>
    </buttons>

    <!-- Paths are relative to /public. Put your own images in /public/images/. -->
    <global-images>
      <headshot>/sample/headshot.svg</headshot>
      <headshot-alt>Riley Carter headshot placeholder</headshot-alt>
      <favicon>/sample/favicon.svg</favicon>
      <!-- Optional social share image. Use a 1200x630 PNG or JPG; most networks ignore SVG.
      <og-image>/images/og-image.png</og-image>
      -->
    </global-images>

    <seo>
      <default-description>Product leader with 11 years building lending, banking and industrial products, from embedded displays to platforms serving 400K+ people a month.</default-description>
      <default-keywords>product management, product leader, fintech, lending, IoT, UX, portfolio</default-keywords>
      <page id="about">
        <title>About Riley Carter | Product Leadership Journey</title>
        <description>Riley Carter's path from controls engineer to product leader across industrial equipment, consumer lending and banking.</description>
      </page>
      <page id="projects">
        <title>Projects | Riley Carter</title>
        <description>Side projects and experiments, including the ones that didn't make it.</description>
      </page>
      <page id="hello">
        <title>Hello | Riley Carter</title>
        <description>A quick tour of Riley Carter's product work.</description>
      </page>
      <page id="privacy">
        <title>Privacy Policy | Riley Carter</title>
        <description>Privacy policy for Riley Carter's portfolio site, including analytics and cookies.</description>
      </page>
      <page id="blog">
        <title>Blog | Riley Carter</title>
        <description>AI prompts, product notes and long-form posts.</description>
      </page>
      <page id="deep-dives">
        <title>Work &amp; Impact | Riley Carter</title>
        <description>Case studies and product briefs from Riley Carter's work in lending, banking and industrial products.</description>
      </page>
      <page id="not-found">
        <title>Page Not Found | Riley Carter</title>
        <description>This page doesn't exist. Here's where to find Riley Carter's work.</description>
      </page>
    </seo>

    <cta-content>
      <heading>Ready to work together?</heading>
      <subheading>Let's talk about the product problem you're trying to solve.</subheading>
      <email-subjects>
        <deep-dive>Discussion: Case Study</deep-dive>
        <industry>Product Leadership Discussion</industry>
        <general>Let's Connect</general>
      </email-subjects>
      <primary-buttons>
        <general>Get in Touch</general>
        <deep-dive>Let's Discuss This Project</deep-dive>
        <industry>Discuss Opportunities</industry>
        <product-brief>Let's Build Something Together</product-brief>
      </primary-buttons>
      <secondary-buttons>
        <view-work>View Related Work</view-work>
        <view-case-studies>View more of my work</view-case-studies>
        <view-projects>View All Projects</view-projects>
      </secondary-buttons>
    </cta-content>
  </global>

</global-elements>
