# Copy to .env.local for local development. All values are optional.
# In production, set these in the Netlify dashboard (Site configuration > Environment variables).

# Canonical site URL for social share tags. Overrides <site-url> in content/global-elements.xml.
SITE_URL=

# Footer freshness date (YYYY-MM-DD). Defaults to the build date.
LAST_UPDATED=

# Google Tag Manager container ID (GTM-XXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity project ID. Leave blank to disable.
MICROSOFT_CLARITY_ID=
